  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#000000"/>
  <title>Evento — TicketHouse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/tokens.css"/>
  <link rel="stylesheet" href="/css/components.css"/>
  <link rel="stylesheet" href="/css/animations.css"/>
  <!-- Recurrente Checkout SDK -->
  <script src="https://cdn.jsdelivr.net/npm/@recurrente/checkout/dist/recurrente-checkout.min.js"></script>
  <style>
    /* ── Reset & Base ─────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    [hidden] { display: none !important; }

    :root {
      --bg:         #000;
      --surface:    #111;
      --surface-2:  #1a1a1a;
      --border:     rgba(255,255,255,.1);
      --border-dim: rgba(255,255,255,.06);
      --text:       #fff;
      --muted:      rgba(255,255,255,.5);
      --dim:        rgba(255,255,255,.3);
      --error:      #f87171;
      --green:      #4ade80;
      --font-title: 'Bebas Neue', sans-serif;
      --font-body:  'Space Grotesk', system-ui, sans-serif;
    }

    html, body {
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
    }

    /* ── Top bar ──────────────────────────────────────────────────── */
    .ev-topbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 90;
      height: 52px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--border-dim);
    }
    .ev-topbar__back {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 22px; line-height: 1;
      color: var(--text); text-decoration: none;
      opacity: .65; transition: opacity .15s;
    }
    .ev-topbar__back:hover { opacity: 1; }
    .ev-topbar__wordmark {
      font-family: var(--font-title);
      font-size: 20px; letter-spacing: .12em;
      color: var(--text);
    }
    .ev-topbar__spacer { width: 36px; }

    /* ── Shell & Split layout ────────────────────────────────────── */
    .ev-shell { min-height: 100dvh; }

    .ev-split {
      display: grid;
      grid-template-columns: 48px 292px 1fr;
      margin-top: 52px;
      align-items: start;
    }

    /* ── Left panel — hero (clean flyer, no text overlay) ──────── */
    .ev-left {
      position: sticky; top: 68px;
      height: 460px;
      overflow: hidden;
      background: #0a0a0a;
      border-radius: 8px;
    }
    @media (min-width: 769px) {
      .ev-left { grid-column: 2 !important; margin: 20px 8px 0 0 !important; }
      .ev-right { grid-column: 3 !important; }
    }

    /* Carousel */
    .ev-carousel { position: absolute; inset: 0; }
    .ev-carousel__slide {
      position: absolute; inset: 0;
      background-size: cover;
      background-position: center 25%;
      opacity: 0;
      transition: opacity 1.2s ease;
    }
    .ev-carousel__slide.active { opacity: 1; }

    /* Very subtle bottom fade so dots are readable */
    .ev-left__overlay {
      position: absolute; inset: 0; z-index: 1;
      background: linear-gradient(0deg,
        rgba(0,0,0,.55) 0%,
        rgba(0,0,0,0) 25%
      );
    }

    /* Dots only — bottom left corner */
    .ev-left__dots-only {
      position: absolute; bottom: 22px; left: 28px; z-index: 2;
    }

    /* Pill dots */
    .ev-carousel__dots { display: flex; gap: 5px; }
    .ev-carousel__dot {
      height: 2px; width: 18px; border-radius: 2px;
      background: rgba(255,255,255,.28); border: none; padding: 0; cursor: pointer;
      transition: background .25s, width .3s;
    }
    .ev-carousel__dot.active { background: #fff; width: 30px; }

    /* ── Right panel event header ────────────────────────────────── */
    .ev-right-header { padding: 52px 40px 20px; }

    .ev-right-date-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
      border-radius: 6px; padding: 5px 12px;
      font-size: 12px; font-weight: 500; color: rgba(255,255,255,.7); letter-spacing: .03em;
      margin-top: 12px; margin-bottom: 14px;
    }
    .ev-right-title {
      font-family: var(--font-title);
      font-size: clamp(52px, 5.5vw, 96px);
      line-height: .9; letter-spacing: .02em; color: #fff;
      margin-top: 12px; margin-bottom: 14px;
    }
    .ev-right-venue-row {
      display: flex; align-items: center; gap: 6px;
      font-size: 13px; color: rgba(255,255,255,.7); margin-bottom: 20px;
    }
    .ev-right-venue-row svg { opacity: .6; flex-shrink: 0; }
    .ev-right-meta-chips {
      display: flex; flex-wrap: wrap; gap: 8px;
    }
    .ev-right-chip {
      display: inline-flex; align-items: center; gap: 5px;
      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
      border-radius: 100px; padding: 6px 14px;
      font-size: 12px; font-weight: 500; color: var(--muted);
    }
    .ev-right-chip--price {
      background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.2);
      color: #fff; font-weight: 700; font-size: 13px;
    }
    .ev-avail { font-size: 12px; font-weight: 500; color: var(--dim); }
    .ev-avail.low { color: #fca5a5; }


    /* ── Precio block ─────────────────────────────────────────────── */
    .ev-price-block { display: none; }
    .ev-price-block-ORIG {
      padding: 0 40px 32px;
    }

    .ev-right-meta-row {
      display: flex; align-items: center; gap: 16px;
      flex-wrap: wrap; margin-top: 12px; margin-bottom: 14px;
    }
    .ev-right-meta-row .ev-right-date-badge { margin-top: 0; margin-bottom: 0; }
    .ev-right-meta-row .ev-right-venue-row  { margin-bottom: 0; }
    /* ── Right panel ──────────────────────────────────────────────── */
    .ev-right {
      background: var(--bg);
      
    }
    .ev-right__inner { max-width: 760px; margin: 0 auto; }

    /* ── Landing: single-page sections ──────────────────────────────── */
    .ev-section-header {
      display: flex; align-items: center; gap: 14px;
      padding: 16px 40px 14px;
    }
    .ev-section-header__label {
      font-size: 11px; font-weight: 700; letter-spacing: .18em;
      text-transform: uppercase; color: rgba(255,255,255,.55); white-space: nowrap; flex-shrink: 0;
    }
    .ev-section-header__line { display: none; }
    .ev-section-divider { display: none; }
    /* Lineup section hidden when no artists */
    #section-lineup.hidden { display: none; }

    /* ── LINE UP section ─────────────────────────────────────────── */
    .ev-lineup-section { padding: 0 40px 28px; }
    .ev-lineup-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 20px 16px;
    }
    .ev-artist-card {
      display: flex; flex-direction: column; align-items: center;
      gap: 10px; text-align: center;
    }
    .ev-artist-photo {
      width: 96px; height: 96px; border-radius: 50%;
      object-fit: cover; background: var(--surface-2);
      border: 2px solid rgba(255,255,255,.12); flex-shrink: 0;
      transition: border-color .2s;
    }
    .ev-artist-card:hover .ev-artist-photo { border-color: rgba(255,255,255,.35); }
    .ev-artist-photo-placeholder {
      width: 96px; height: 96px; border-radius: 50%;
      background: var(--surface); border: 2px solid var(--border-dim);
      display: grid; place-items: center;
      font-size: 30px; color: var(--dim); flex-shrink: 0;
    }
    .ev-artist-name {
      font-size: 13px; font-weight: 700; color: var(--text);
      line-height: 1.2; letter-spacing: .01em;
    }
    .ev-artist-role {
      font-size: 10px; color: var(--dim); letter-spacing: .08em;
      text-transform: uppercase; margin-top: -4px;
    }
    .ev-artist-genres {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 4px;
    }
    .ev-artist-genre {
      padding: 2px 8px; border-radius: 100px;
      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.08);
      font-size: 10px; color: var(--dim);
    }

    .ev-artist-bio {
      font-size: 11px; color: var(--dim); line-height: 1.5;
      max-width: 140px; margin-top: -4px;
    }
    .ev-artist-instagram {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 11px; color: var(--dim); text-decoration: none;
      opacity: .7; transition: opacity .2s;
    }
    .ev-artist-instagram:hover { opacity: 1; color: #fff; }

    /* ── ENTRADAS section ────────────────────────────────────────── */
    .ev-tickets-section { padding: 0 40px 28px; }
    .ev-ticket-type-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 14px; overflow: hidden; margin-bottom: 14px;
    }
    .ev-ticket-type-card__body {
      display: flex; align-items: center; justify-content: space-between;
      padding: 22px 24px; gap: 16px;
    }
    .ev-ticket-type-name { font-size: 15px; font-weight: 700; color: #fff; letter-spacing: .01em; }
    .ev-ticket-type-note { font-size: 12px; color: rgba(255,255,255,.65); margin-top: 4px; }
    .ev-ticket-type-price-val {
      font-family: var(--font-title); font-size: 38px; letter-spacing: .04em;
      color: #fff; white-space: nowrap; line-height: 1;
    }
    .ev-ticket-type-price-note { font-size: 11px; color: rgba(255,255,255,.6); margin-top: 4px; text-align: right; }
    .ev-avail-bar {
      display: flex; align-items: center; gap: 8px;
      padding: 11px 24px; border-top: 1px solid var(--border-dim);
      font-size: 12px; color: rgba(255,255,255,.65);
    }
    .ev-avail-bar .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); flex-shrink: 0; }
    .ev-avail-bar.low .dot { background: #fca5a5; }
    .ev-avail-bar.low { color: #fca5a5; }

    .ev-buy-cta {
      width: 100%; padding: 17px 24px;
      background: #fff; color: #000;
      border: none; border-radius: 10px;
      font-family: var(--font-body);
      font-size: 14px; font-weight: 700; letter-spacing: .08em;
      cursor: pointer; transition: opacity .15s, transform .1s;
    }
    .ev-buy-cta:hover { opacity: .88; }
    .ev-buy-cta:active { transform: translateY(1px); }
    .ev-buy-cta:disabled { opacity: .35; cursor: not-allowed; }

    /* ── INFO section ────────────────────────────────────────────── */
    .ev-info-section { padding: 0 40px 48px; }
    .ev-info-meta-row {
      display: flex; align-items: center; gap: 16px;
      padding: 14px 0; border-bottom: 1px solid var(--border-dim);
    }
    .ev-info-meta-row:first-child { border-top: none; }
    .ev-info-meta-icon {
      font-size: 16px; width: 22px; text-align: center;
      flex-shrink: 0; opacity: .6;
    }
    .ev-info-meta-label {
      font-size: 11px; color: rgba(255,255,255,.55); font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase; min-width: 54px; flex-shrink: 0;
    }
    .ev-info-meta-value { font-size: 14px; color: var(--text); font-weight: 500; line-height: 1.35; }
    .ev-info-divider { display: none; }
    .ev-info-desc { font-size: 14px; color: var(--muted); line-height: 1.8; padding-top: 16px; }

    /* ── Sticky bottom buy bar (always visible) ── */
    #ev-sticky-buy {
      display: none !important;
      position: sticky; bottom: 0;
      background: rgba(0,0,0,.92); backdrop-filter: blur(12px);
      border-top: 1px solid var(--border-dim);
      padding: 14px 40px calc(14px + env(safe-area-inset-bottom));
      display: block;
    }
    .ev-sticky-inner {
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
    }
    .ev-sticky-price { font-family: var(--font-title); font-size: 28px; color: #fff; letter-spacing: .04em; }
    .ev-sticky-note  { font-size: 11px; color: var(--dim); margin-top: 1px; }

    /* ── Checkout panel ───────────────────────────────────────────── */
    #ev-checkout { display: none; }
    #ev-checkout.visible {
      display: block;
      animation: xfadeUp .25s ease-out;
    }

    @keyframes xfadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Tab navigation ───────────────────────────────────────────── */
    .step-tabs {
      display: flex;
      border-bottom: 1px solid var(--border-dim);
      padding: 0 40px;
      position: sticky; top: 0; z-index: 10;
      background: var(--bg);
    }
    .step-tab {
      flex: 1; padding: 16px 4px 14px;
      font-family: var(--font-body);
      font-size: 11px; font-weight: 600;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--dim); background: none; border: none;
      border-bottom: 2px solid transparent;
      cursor: pointer; transition: color .15s, border-color .15s;
      text-align: center; white-space: nowrap;
    }
    .step-tab.active { color: var(--text); border-bottom-color: #fff; }
    .step-tab.done   { color: var(--muted); cursor: pointer; }
    .step-tab:disabled:not(.done) { cursor: default; }

    /* Back to info link inside checkout */
    .checkout-back-link {
      display: flex; align-items: center; gap: 6px;
      padding: 12px 40px 0;
      font-size: 12px; color: var(--dim);
      cursor: pointer; border: none; background: none;
      font-family: var(--font-body);
      transition: color .15s;
    }
    .checkout-back-link:hover { color: var(--text); }

    /* ── Step panels ──────────────────────────────────────────────── */
    .step-panel { display: none; }
    .step-panel.active { display: block; animation: xfadeUp .22s ease-out; }

    .step-body { padding: 28px 40px 80px; }

    .step-heading {
      font-family: var(--font-title);
      font-size: 44px; letter-spacing: .04em;
      color: #fff; margin-bottom: 4px;
    }
    .step-sub { font-size: 13px; color: var(--dim); margin-bottom: 28px; line-height: 1.6; }

    /* ── Form elements ────────────────────────────────────────────── */
    .ph-form-group { margin-bottom: 20px; }
    .ph-form-group__label {
      display: block; font-size: 11px; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 8px;
    }
    .ph-input {
      width: 100%; padding: 13px 14px;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; color: #fff;
      font-family: var(--font-body); font-size: 15px;
      outline: none; transition: border-color .15s;
    }
    .ph-input::placeholder { color: var(--dim); }
    .ph-input:focus { border-color: rgba(255,255,255,.35); }
    .ph-input.is-error { border-color: var(--error); }
    .ph-form-group__error { display: block; font-size: 12px; color: var(--error); margin-top: 6px; }

    .email-note {
      display: flex; align-items: flex-start; gap: 10px;
      background: var(--surface); border: 1px solid var(--border-dim);
      border-radius: 8px; padding: 12px 14px; margin-top: 10px;
    }
    .email-note__icon { opacity: .5; margin-top: 1px; }
    .email-note p { font-size: 12px; color: var(--dim); line-height: 1.6; }

    #discount-apply-btn {
      display: block; width: 100%; margin-top: 8px;
      padding: 11px 16px; background: transparent;
      border: 1px solid var(--border); border-radius: 8px;
      color: var(--muted); font-family: var(--font-body);
      font-size: 11px; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
      cursor: pointer; transition: border-color .15s, color .15s;
    }
    #discount-apply-btn:hover { border-color: rgba(255,255,255,.3); color: var(--text); }

    /* ── Ticket card (quantity selector) ─────────────────────────── */
    .ticket-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden; margin-bottom: 20px;
    }
    .ticket-card__header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px;
    }
    .ticket-card__name  { font-size: 15px; font-weight: 600; color: #fff; }
    .ticket-card__from  { font-size: 13px; color: var(--muted); margin-top: 2px; }

    .qty-row {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 20px; border-top: 1px solid var(--border-dim);
    }
    .qty-btn {
      width: 34px; height: 34px; border-radius: 50%;
      border: 1px solid var(--border); background: transparent;
      color: #fff; font-size: 18px; cursor: pointer;
      display: grid; place-items: center; flex-shrink: 0;
      transition: background .12s, border-color .12s; line-height: 1;
    }
    .qty-btn:hover:not(:disabled) { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.3); }
    .qty-btn:disabled { opacity: .22; cursor: not-allowed; }
    .qty-value {
      font-family: var(--font-title); font-size: 44px; line-height: 1;
      color: #fff; min-width: 36px; text-align: center; letter-spacing: .02em;
    }
    .qty-hint { margin-left: auto; font-size: 11px; color: var(--dim); }

    /* ── Checkboxes ───────────────────────────────────────────────── */
    .ev-checkbox-list { display: flex; flex-direction: column; gap: 14px; }
    .ev-checkbox { display: flex; align-items: flex-start; gap: 12px; cursor: pointer; }
    .ev-checkbox input[type="checkbox"] { width: 18px; height: 18px; min-width: 18px; margin-top: 2px; cursor: pointer; accent-color: #fff; }
    .ev-checkbox__text { font-size: 13px; color: var(--muted); line-height: 1.55; }
    .ev-checkbox__text a { color: var(--text); text-decoration: underline; text-underline-offset: 2px; }

    /* ── Order summary ────────────────────────────────────────────── */
    .order-summary {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; padding: 16px 20px; margin-top: 20px;
    }
    .order-summary__row {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 14px; color: var(--muted); padding: 5px 0;
    }
    .order-summary__row--total {
      border-top: 1px solid var(--border-dim);
      margin-top: 8px; padding-top: 13px !important;
      color: #fff; font-weight: 600;
    }
    .order-summary__row--total span:last-child { font-family: var(--font-title); font-size: 26px; letter-spacing: .04em; }
    #summary-discount-row { color: var(--green) !important; font-size: 13px; }
    #summary-discount-row span:last-child { font-family: var(--font-body) !important; font-size: 14px !important; color: var(--green) !important; }

    /* ── Mini summary (step 3) ───────────────────────────────────── */
    .mini-summary {
      display: flex; justify-content: space-between; align-items: center;
      padding: 14px 18px; background: var(--surface);
      border: 1px solid var(--border); border-radius: 10px;
      margin-bottom: 20px; font-size: 14px; color: var(--muted);
    }
    .mini-summary strong { font-family: var(--font-title); font-size: 26px; letter-spacing: .04em; color: #fff; }

    /* ── Recurrente container ────────────────────────────────────── */
    #recurrente-wrap {
      min-height: 400px; border-radius: 10px; overflow: hidden;
      background: var(--surface); border: 1px solid var(--border);
    }
    .checkout-loading {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 14px; padding: 60px 24px; color: var(--dim); font-size: 13px; letter-spacing: .04em;
    }
    .checkout-spinner {
      width: 28px; height: 28px; border: 2px solid rgba(255,255,255,.1);
      border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .checkout-error { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 40px 24px; text-align: center; }
    .checkout-error p { font-size: 13px; color: var(--dim); line-height: 1.6; }
    .checkout-error__retry {
      padding: 10px 24px; background: transparent; border: 1px solid var(--border);
      border-radius: 8px; color: #fff; font-family: var(--font-body);
      font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
      cursor: pointer; transition: background .15s;
    }
    .checkout-error__retry:hover { background: var(--surface); }

    /* ── Buttons ──────────────────────────────────────────────────── */
    .ph-btn {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 13px 24px; border-radius: 8px;
      font-family: var(--font-body); font-size: 14px; font-weight: 600;
      letter-spacing: .04em; cursor: pointer;
      transition: opacity .15s, transform .1s;
      text-decoration: none; text-align: center; border: none; outline: none;
    }
    .ph-btn:hover { opacity: .88; }
    .ph-btn:active { transform: translateY(1px); }
    .ph-btn:disabled { opacity: .3; cursor: not-allowed; transform: none !important; }
    .ph-btn--primary { background: #fff; color: #000; }
    .ph-btn--ghost {
      background: transparent; border: 1px solid var(--border); color: var(--muted);
    }
    .ph-btn--ghost:hover { border-color: rgba(255,255,255,.3); color: var(--text); }

    .step-nav { display: flex; gap: 10px; margin-top: 20px; }
    .step-nav .ph-btn { flex: 1; }

    /* ── State screens ────────────────────────────────────────────── */
    .ev-state {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      min-height: calc(100dvh - 52px); padding: 48px 24px; text-align: center; margin-top: 52px;
    }
    .ev-global-error h2 { font-family: var(--font-title); font-size: 36px; color: var(--error); letter-spacing: .06em; margin-bottom: 12px; }
    .ev-global-error p  { color: var(--dim); font-size: 14px; margin-bottom: 24px; }
    .ev-soldout { background: rgba(248,113,113,.05); border: 1px solid rgba(248,113,113,.2); border-radius: 14px; padding: 48px 40px; }
    .ev-soldout h2 { font-family: var(--font-title); font-size: 64px; color: var(--error); letter-spacing: .06em; }
    .ev-soldout p { color: var(--dim); margin-top: 12px; font-size: 14px; line-height: 1.6; }

    #loading-state {
      position: fixed; inset: 0; display: grid; place-items: center;
      background: var(--bg); z-index: 200;
    }
    .ph-spinner--lg {
      width: 32px; height: 32px; border: 2px solid rgba(255,255,255,.1);
      border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite;
    }

    /* ── Mobile bottom CTA ──────────────────────────────────────── */
    #mobile-cta {
      display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 150;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: var(--surface); border-top: 1px solid var(--border-dim);
      align-items: center; gap: 10px;
    }
    .mcta-total-block { display: flex; flex-direction: column; flex-shrink: 0; }
    .mcta-total-label { font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
    .mcta-total-value { font-family: var(--font-title); font-size: 22px; letter-spacing: .04em; color: #fff; }
    .mcta-back {
      flex-shrink: 0; padding: 12px 14px; border: 1px solid var(--border);
      border-radius: 8px; background: transparent; color: var(--muted);
      font-family: var(--font-body); font-size: 13px; cursor: pointer;
      transition: color .15s, border-color .15s;
    }
    .mcta-back:hover { color: #fff; border-color: rgba(255,255,255,.3); }
    .mcta-main-btn { flex: 1; }

    /* ── Responsive ──────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .ev-topbar { padding: 0 12px; }
      .ev-split { grid-template-columns: 1fr; min-height: auto; }
      .ev-left { grid-column: 1; margin: 0; }
      .ev-right { grid-column: 1; }
      .ev-left {
        position: relative; top: auto;
        height: 48vmax; min-height: 240px; max-height: 380px;
        border-radius: 0;
        margin: 0;
      }
      .ev-left__content { padding: 16px 18px 20px; }
      .ev-left__title { font-size: clamp(30px, 9vw, 50px); margin-bottom: 8px; }
      .ev-right { height: auto; overflow-y: visible; border-left: none; border-top: 1px solid var(--border-dim); }
      .ev-right__inner { max-width: 100%; }

      .ev-right-header { padding: 22px 18px 20px; }
      .ev-right-title  { font-size: clamp(34px, 9vw, 54px); }
      .ev-section-header { padding: 22px 18px 14px; }
      .ev-lineup-section, .ev-tickets-section, .ev-info-section { padding: 0 18px 24px; }
      .ev-ticket-type-card__body { padding: 18px 18px; }
      .ev-avail-bar { padding: 10px 18px; }
      #ev-sticky-buy {
      display: none !important; padding: 12px 18px calc(12px + env(safe-area-inset-bottom)); }
      .step-tabs     { padding: 0 18px; }
      .step-body     { padding: 20px 18px 100px; }
      .checkout-back-link { padding: 12px 18px 0; }

      #mobile-cta { display: flex; }
      #step1-next, #step2-next, #step2-back { display: none; }
      #ev-sticky-buy {
      display: none !important; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); }
    }

    @media (min-width: 769px) {
      #mobile-cta { display: none !important; }
    }
  </style>
</head>
