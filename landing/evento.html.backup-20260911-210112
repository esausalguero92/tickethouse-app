<script>
'use strict';

const { api, getParam, navigate, formatDate } = window.PH;

// ── State ──────────────────────────────────────────────────────────────
let event           = null;
let quantity        = 1;
let maxQty          = 10;
let orderId         = null;
let currentStep     = 1;
let appliedDiscount = null;
let checkoutMounted = false;
let checkoutOpen    = false; // true after clicking "Comprar entrada"

// ── Helpers ─────────────────────────────────────────────────────────────
function gtqPrice() {
  return Number(event && event.price_gtq ? event.price_gtq : 0);
}

// ── Init ─────────────────────────────────────────────────────────────────
async function init() {
  const id   = getParam('id');
  const code = getParam('c');
  let apiData = null;

  try {
    const cached   = sessionStorage.getItem('ph_event');
    const cachedId = sessionStorage.getItem('ph_event_id');
    if (cached && cachedId && cachedId === id) {
      event = JSON.parse(cached);
    }
  } catch {}

  if (!event) {
    try {
      if (id) {
        apiData = await api('GET', '/api/events/' + encodeURIComponent(id));
        event   = apiData.event;
        sessionStorage.setItem('ph_event', JSON.stringify(event));
        sessionStorage.setItem('ph_event_id', id);
        sessionStorage.setItem('ph_event_code_id', apiData.event_code_id || '');
      } else if (code) {
        apiData = await api('GET', '/api/event/' + encodeURIComponent(code));
        event   = apiData.event;
        sessionStorage.setItem('ph_event', JSON.stringify(event));
        sessionStorage.setItem('ph_event_id', event.id || '');
        sessionStorage.setItem('ph_event_code', code);
        sessionStorage.setItem('ph_event_code_id', apiData.event_code_id || '');
      } else {
        return showGlobalError();
      }
    } catch { return showGlobalError(); }
  } else if (id) {
    // Fetch fresh artists even when event was cached (they may have been added)
    try {
      apiData = await api('GET', '/api/events/' + encodeURIComponent(id));
    } catch {}
  }

  document.getElementById('loading-state').hidden = true;

  const available = event.capacity != null
    ? Math.max((event.capacity) - (event.tickets_sold || 0), 0)
    : null;

  if (available === 0) {
    document.getElementById('soldout-banner').hidden = false;
    return;
  }

  if (available != null) maxQty = Math.min(10, available);

  renderEvent(available, apiData && apiData.artists || []);
  setupQuantityStepper();
  setupSteps();
  setupDiscountCode();
  setupLanding();
}

// ── Render event data ─────────────────────────────────────────────────────
function renderEvent(available, artists) {
  const title    = event.name || 'Evento';
  const dateStr  = formatDate(event.event_date);
  const venue    = event.venue || '—';
  const price    = gtqPrice();

  // Right panel header (title, date, venue, price)
  document.getElementById('ev-title-right').textContent = title;
  document.getElementById('ev-date-right').textContent  = dateStr;
  document.getElementById('ev-venue-right').textContent = venue;
  document.getElementById('ev-price-right').textContent = 'Q' + price.toFixed(2);

  const availEl = document.getElementById('ev-avail-right');
  if (available != null && available <= 20) {
    availEl.textContent = available + ' disponibles';
    availEl.style.display = '';
    availEl.classList.toggle('low', available <= 5);
    if (available <= 5) availEl.style.color = '#fca5a5';
  }

  // ── INFO tab ──────────────────────────────────────────────────────
  document.getElementById('info-date').textContent  = dateStr;
  document.getElementById('info-venue').textContent = venue;

  if (event.event_date) {
    var d = new Date(event.event_date);
    var h = d.getHours(), m = d.getMinutes();
    if (h || m) {
      var timeStr = d.toLocaleTimeString('es-GT', { hour: '2-digit', minute: '2-digit' });
      document.getElementById('info-time').textContent = timeStr;
      document.getElementById('info-time-row').style.display = '';
    }
  }

  if (event.description) {
    document.getElementById('info-desc').textContent = event.description;
    document.getElementById('info-desc-wrap').style.display = '';
  }

  // ── ENTRADAS tab ──────────────────────────────────────────────────
  document.getElementById('tt-name').textContent  = title;
  document.getElementById('tt-price').textContent = 'Q' + price.toFixed(2);
  document.getElementById('sticky-price').textContent = 'Q' + price.toFixed(2);

  var avBar  = document.getElementById('tt-avail-bar');
  var avText = document.getElementById('tt-avail-text');
  if (available != null) {
    if (available <= 5) {
      avBar.classList.add('low');
      avText.textContent = available + ' entradas restantes';
    } else if (available <= 20) {
      avText.textContent = available + ' disponibles';
    } else {
      avText.textContent = 'Disponible';
    }
  }

  // ── LINE UP section — artist cards ──────────────────────────────
  var grid         = document.getElementById('ev-artist-grid');
  var secLineup    = document.getElementById('section-lineup');
  var secDivider   = secLineup ? secLineup.nextElementSibling : null;
  if (artists && artists.length) {
    grid.innerHTML = artists.map(function(a) {
      var photoHtml = a.photo_url
        ? '<img class="ev-artist-photo" src="' + a.photo_url.replace(/"/g,'%22') + '" alt="' + (a.name||'').replace(/"/g,'&quot;') + '" loading="lazy">'
        : '<div class="ev-artist-photo-placeholder">🎧</div>';
      var genreHtml = (a.genres||[]).slice(0,3).map(function(g) {
        return '<span class="ev-artist-genre">' + g + '</span>';
      }).join('');
      return '<div class="ev-artist-card">'
        + photoHtml
        + '<div class="ev-artist-name">' + (a.name||'').replace(/</g,'&lt;') + '</div>'
        + (a.role && a.role !== 'performer' ? '<div class="ev-artist-role">' + a.role + '</div>' : '')
        + (genreHtml ? '<div class="ev-artist-genres">' + genreHtml + '</div>' : '')
        + (a.bio ? '<div class="ev-artist-bio">' + a.bio.replace(/</g,'&lt;').substring(0,120) + (a.bio.length>120?'…':'') + '</div>' : '')
        + (a.instagram ? '<a class="ev-artist-instagram" href="https://instagram.com/' + a.instagram.replace(/^@/,'').replace(/"/g,'%22') + '" target="_blank" rel="noopener">📷 @' + a.instagram.replace(/^@/,'').replace(/</g,'&lt;') + '</a>' : '')
        + '</div>';
    }).join('');
  } else {
    // Hide lineup section + its divider when no artists
    if (secLineup) secLineup.style.display = 'none';
    if (secDivider) secDivider.style.display = 'none';
  }

  // Ticket card (checkout wizard)
  var tcName  = document.getElementById('ticket-card-name');
  var tcPrice = document.getElementById('ticket-card-price');
  if (tcName)  tcName.textContent  = title;
  if (tcPrice) tcPrice.textContent = 'Q' + price.toFixed(2) + ' por entrada';

  // Carousel
  (function initCarousel() {
    const track    = document.getElementById('ev-carousel');
    const dotsWrap = document.getElementById('ev-carousel-dots');
    if (!track) return;

    const imgs = (Array.isArray(event.images) && event.images.length)
      ? event.images
      : (event.image_url ? [event.image_url] : []);
    if (!imgs.length) return;

    let current = 0, timer = null, startX = null;
    const slides = [], dots = [];

    imgs.forEach((url, i) => {
      const slide = document.createElement('div');
      slide.className = 'ev-carousel__slide' + (i === 0 ? ' active' : '');
      slide.style.backgroundImage = 'url("' + url.replace(/"/g, '%22') + '")';
      track.appendChild(slide);
      slides.push(slide);
      new Image().src = url;
    });

    if (imgs.length > 1) {
      imgs.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.className = 'ev-carousel__dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Imagen ' + (i + 1));
        dot.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(dot);
        dots.push(dot);
      });
    }

    function goTo(n) {
      slides[current].classList.remove('active');
      if (dots[current]) dots[current].classList.remove('active');
      current = (n + imgs.length) % imgs.length;
      slides[current].classList.add('active');
      if (dots[current]) dots[current].classList.add('active');
      resetTimer();
    }
    function resetTimer() {
      clearInterval(timer);
      if (imgs.length > 1) timer = setInterval(() => goTo(current + 1), 4500);
    }
    track.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', e => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
      startX = null;
    }, { passive: true });
    track.addEventListener('mousedown', e => { startX = e.clientX; });
    track.addEventListener('mouseup', e => {
      if (startX === null) return;
      if (Math.abs(e.clientX - startX) > 40) goTo(current + (e.clientX - startX < 0 ? 1 : -1));
      startX = null;
    });
    resetTimer();
  })();

  document.getElementById('main-content').hidden = false;
  updateSummary();
  updateMobileCta(0); // 0 = landing state
}

// ── Landing: buy buttons + checkout ─────────────────────────────────────
function setupLanding() {
  // Buy buttons
  var btnBuy       = document.getElementById('btn-buy');
  var btnBuySticky = document.getElementById('btn-buy-sticky');
  if (btnBuy)       btnBuy.addEventListener('click', openCheckout);
  if (btnBuySticky) btnBuySticky.addEventListener('click', openCheckout);

  document.getElementById('checkout-back-to-info').addEventListener('click', closeCheckout);

  // Mobile CTA on landing = open checkout
  document.getElementById('mcta-main').addEventListener('click', function() {
    if (!checkoutOpen) {
      openCheckout();
    } else if (currentStep === 1 && validateStep1()) {
      goToStep(2);
    } else if (currentStep === 2 && validateStep2()) {
      goToStep(3); initCheckout();
    }
  });

  document.getElementById('mcta-back').addEventListener('click', function() {
    if (currentStep > 1) {
      if (currentStep === 3) checkoutMounted = false;
      goToStep(currentStep - 1);
    } else {
      closeCheckout();
    }
  });
}

function openCheckout() {
  checkoutOpen = true;
  document.getElementById('ev-info').style.display     = 'none';
  document.getElementById('ev-checkout').classList.add('visible');
  goToStep(1);
  var evRight = document.querySelector('.ev-right');
  if (evRight) evRight.scrollTo({ top: 0, behavior: 'smooth' });
  window.scrollTo({ top: document.querySelector('.ev-split') ? document.querySelector('.ev-split').offsetTop : 0, behavior: 'smooth' });
}

function closeCheckout() {
  checkoutOpen = false;
  document.getElementById('ev-checkout').classList.remove('visible');
  document.getElementById('ev-info').style.display = '';
  updateMobileCta(0);
  var evRight = document.querySelector('.ev-right');
  if (evRight) evRight.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── Quantity stepper ─────────────────────────────────────────────────────
function setupQuantityStepper() {
  const minus = document.getElementById('qty-minus');
  const plus  = document.getElementById('qty-plus');
  const disp  = document.getElementById('qty-display');
  const hint  = document.getElementById('qty-hint');

  hint.textContent = 'Máx. ' + (maxQty < 10 ? maxQty : 10);

  function update() {
    disp.textContent = quantity;
    minus.disabled   = quantity <= 1;
    plus.disabled    = quantity >= maxQty;
    updateSummary();
  }

  minus.addEventListener('click', function() { if (quantity > 1)      { quantity--; update(); } });
  plus.addEventListener('click',  function() { if (quantity < maxQty) { quantity++; update(); } });
  update();
}

function updateSummary() {
  const price = gtqPrice();
  const base  = price * quantity;
  const label = quantity + ' ' + (quantity === 1 ? 'entrada' : 'entradas');

  document.getElementById('summary-line').textContent  = label + ' x Q' + price.toFixed(2);
  document.getElementById('summary-total').textContent = 'Q' + base.toFixed(2);

  var discRow = document.getElementById('summary-discount-row');
  if (discRow) discRow.style.display = 'none';

  var ml = document.getElementById('mini-summary-line');
  var mt = document.getElementById('mini-summary-total');
  var mc = document.getElementById('mcta-total');
  if (ml) ml.textContent = label;
  if (mt) mt.textContent = 'Q' + base.toFixed(2);
  if (mc) mc.textContent = 'Q' + base.toFixed(2);

  if (appliedDiscount) reapplyDiscount();
}

function reapplyDiscount() {
  if (!appliedDiscount) return;
  const base = gtqPrice() * quantity;
  let disc;
  if (appliedDiscount.discount_type === 'fixed') {
    disc = Math.min(appliedDiscount.discount_value, base);
  } else {
    disc = base * appliedDiscount.discount_value / 100;
  }
  const final = base - disc;
  appliedDiscount = { ...appliedDiscount, discount_gtq: disc, final_gtq: final };
  applySummaryDiscount(disc, final);
}

function applySummaryDiscount(discGTQ, finalGTQ) {
  var discRow   = document.getElementById('summary-discount-row');
  var discLabel = document.getElementById('summary-discount-label');
  var discAmt   = document.getElementById('summary-discount-amount');
  var totalEl   = document.getElementById('summary-total');
  var mt        = document.getElementById('mini-summary-total');
  var mc        = document.getElementById('mcta-total');

  if (discRow) {
    discLabel.textContent = appliedDiscount && appliedDiscount.code
      ? 'Descuento (' + appliedDiscount.code + ')'
      : 'Descuento';
    discAmt.textContent   = '-Q' + discGTQ.toFixed(2);
    discRow.style.display = '';
  }
  if (totalEl) totalEl.textContent = 'Q' + finalGTQ.toFixed(2);
  if (mt)      mt.textContent      = 'Q' + finalGTQ.toFixed(2);
  if (mc)      mc.textContent      = 'Q' + finalGTQ.toFixed(2);
}

// ── Discount code ─────────────────────────────────────────────────────────
function setupDiscountCode() {
  var applyBtn  = document.getElementById('discount-apply-btn');
  var codeInput = document.getElementById('discount-code');
  if (!applyBtn || !codeInput) return;

  applyBtn.addEventListener('click', applyDiscountCode);
  codeInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); applyDiscountCode(); }
  });
  codeInput.addEventListener('input', function() {
    if (!codeInput.value.trim() && appliedDiscount) {
      appliedDiscount = null;
      var fb = document.getElementById('discount-feedback');
      if (fb) fb.style.display = 'none';
      updateSummary();
    }
  });
}

async function applyDiscountCode() {
  if (!event) return;
  var codeInput = document.getElementById('discount-code');
  var feedback  = document.getElementById('discount-feedback');
  var applyBtn  = document.getElementById('discount-apply-btn');
  var code = (codeInput.value || '').trim().toUpperCase();
  if (!code) return;

  applyBtn.disabled = true;
  feedback.style.display = '';
  feedback.style.color   = 'var(--dim)';
  feedback.textContent   = 'Verificando…';

  try {
    var data = await api('POST', '/api/discount/validate', {
      code,
      event_id:   event.id,
      amount_usd: gtqPrice() * quantity,
    });

    const base = gtqPrice() * quantity;
    let discGTQ, finalGTQ;
    if (data.discount_type === 'fixed') {
      discGTQ = Math.min(data.discount_value, base);
    } else {
      discGTQ = base * data.discount_value / 100;
    }
    finalGTQ = base - discGTQ;

    appliedDiscount = { ...data, code, discount_gtq: discGTQ, final_gtq: finalGTQ };
    feedback.style.color = 'var(--green)';
    feedback.textContent = '✓ Código aplicado: ' + (
      data.discount_type === 'percent'
        ? data.discount_value + '% de descuento'
        : 'Q' + discGTQ.toFixed(2) + ' de descuento'
    );
    applySummaryDiscount(discGTQ, finalGTQ);

  } catch (err) {
    appliedDiscount = null;
    feedback.style.color = 'var(--error)';
    feedback.textContent = (err.data && err.data.message) ? err.data.message : 'Código inválido.';
  } finally {
    applyBtn.disabled = false;
  }
}

// ── Step wizard ───────────────────────────────────────────────────────────
function setupSteps() {
  document.getElementById('step1-next').addEventListener('click', function() {
    if (validateStep1()) goToStep(2);
  });
  document.getElementById('step2-back').addEventListener('click', function() { goToStep(1); });
  document.getElementById('step2-next').addEventListener('click', function() {
    if (validateStep2()) { goToStep(3); initCheckout(); }
  });
  document.getElementById('step3-back').addEventListener('click', function() {
    checkoutMounted = false; goToStep(2);
  });
  document.getElementById('checkout-retry-btn').addEventListener('click', function() {
    document.getElementById('checkout-error').hidden = true;
    document.getElementById('checkout-loading').style.display = 'flex';
    initCheckout();
  });

  // Allow clicking done tabs to go back
  document.getElementById('sn-1').addEventListener('click', function() {
    if (currentStep > 1) goToStep(1);
  });
  document.getElementById('sn-2').addEventListener('click', function() {
    if (currentStep > 2) goToStep(2);
  });
}

function goToStep(n) {
  document.querySelectorAll('.step-panel').forEach(function(p, i) {
    p.classList.toggle('active', i + 1 === n);
  });

  ['sn-1','sn-2','sn-3'].forEach(function(id, i) {
    var tab = document.getElementById(id);
    if (!tab) return;
    var stepNum = i + 1;
    tab.classList.toggle('active', stepNum === n);
    tab.classList.toggle('done',   stepNum < n);
    tab.disabled = stepNum > n;
    tab.setAttribute('aria-selected', stepNum === n ? 'true' : 'false');
  });

  currentStep = n;
  updateMobileCta(n);

  var evRight = document.querySelector('.ev-right');
  if (evRight) evRight.scrollTo({ top: 0, behavior: 'smooth' });
  window.scrollTo({ top: evRight ? evRight.offsetTop : 0, behavior: 'smooth' });
}

function updateMobileCta(n) {
  var bar        = document.getElementById('mobile-cta');
  var btnMain    = document.getElementById('mcta-main');
  var btnBack    = document.getElementById('mcta-back');
  var priceBlock = document.getElementById('mcta-price-block');
  var isMob      = window.innerWidth <= 768;

  if (!isMob) { bar.style.display = 'none'; return; }

  bar.style.display = 'flex';

  if (n === 0) {
    // Landing state: show "Comprar entrada" with price
    if (priceBlock) priceBlock.style.display = 'flex';
    btnBack.style.display  = 'none';
    btnBack.style.flex     = '';
    btnMain.style.display  = 'inline-flex';
    btnMain.textContent    = 'Comprar entrada';
    // update total label
    var mc = document.getElementById('mcta-total');
    if (mc) mc.textContent = 'Q' + gtqPrice().toFixed(2);
  } else if (n === 3) {
    if (priceBlock) priceBlock.style.display = 'none';
    btnMain.style.display = 'none';
    btnBack.style.display = 'block';
    btnBack.style.flex    = '1';
  } else {
    if (priceBlock) priceBlock.style.display = 'flex';
    btnBack.style.display = (n === 1) ? 'block' : 'block'; // step 1 = back to info
    btnBack.style.flex    = '';
    btnMain.style.display = 'inline-flex';
    btnMain.textContent   = n === 1 ? 'Continuar' : 'Confirmar pedido';
    btnBack.textContent   = n === 1 ? '← Evento' : '← Atrás';
  }
}

// ── Validation ────────────────────────────────────────────────────────────
function validateStep1() {
  clearErrors();
  var valid = true;
  var name  = document.getElementById('buyer-name').value.trim();
  if (name.length < 2) { markError('buyer-name','err-name','Ingresa tu nombre completo.'); valid = false; }
  var email = document.getElementById('buyer-email').value.trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { markError('buyer-email','err-email','Ingresa un correo válido.'); valid = false; }
  return valid;
}

function validateStep2() {
  clearErrors();
  var age   = document.getElementById('age-check').checked;
  var terms = document.getElementById('terms-check').checked;
  if (!age || !terms) { showErr('err-checks','Debes aceptar ambas confirmaciones para continuar.'); return false; }
  return true;
}

function clearErrors() {
  ['err-name','err-email','err-checks'].forEach(function(id) { showErr(id,''); });
  document.querySelectorAll('.ph-input').forEach(function(i) { i.classList.remove('is-error'); });
}

function markError(inputId, errId, msg) {
  var input = document.getElementById(inputId);
  if (input) input.classList.add('is-error');
  showErr(errId, msg);
}

function showErr(id, msg) {
  var el = document.getElementById(id);
  if (!el) return;
  el.textContent = msg;
  el.hidden = !msg;
}

function showGlobalError() {
  document.getElementById('loading-state').hidden = true;
  document.getElementById('global-error').hidden  = false;
}

// ── Payment intent ────────────────────────────────────────────────────────
async function createPaymentIntent() {
  var payload = {
    event_id:       event.id,
    event_code:     sessionStorage.getItem('ph_event_code') || '',
    event_code_id:  sessionStorage.getItem('ph_event_code_id') || '',
    full_name:      document.getElementById('buyer-name').value.trim(),
    email:          document.getElementById('buyer-email').value.trim().toLowerCase(),
    quantity,
    age_verified:   document.getElementById('age-check').checked,
    terms_accepted: document.getElementById('terms-check').checked,
  };
  if (appliedDiscount && appliedDiscount.code) {
    payload.discount_code = appliedDiscount.code;
  }
  var data = await api('POST', '/api/payment/intent', payload);
  orderId = data.order_id;
  return orderId;
}

// ── Recurrente checkout ───────────────────────────────────────────────────
async function initCheckout() {
  if (checkoutMounted) return;

  const loadingEl   = document.getElementById('checkout-loading');
  const errorEl     = document.getElementById('checkout-error');
  const containerEl = document.getElementById('recurrente-checkout-container');

  loadingEl.style.display = 'flex';
  errorEl.hidden          = true;
  containerEl.innerHTML   = '';

  try {
    if (!orderId) await createPaymentIntent();

    var res         = await api('POST', '/api/payment/recurrente/checkout', { order_id: orderId });
    var checkoutUrl = res.checkout_url;
    if (!checkoutUrl) throw new Error('No checkout URL received');

    loadingEl.style.display = 'none';
    checkoutMounted = true;

    if (typeof RecurrenteCheckout !== 'undefined') {
      var checkout = new RecurrenteCheckout({
        checkoutUrl,
        container: '#recurrente-checkout-container',
        onSuccess: function() { onPaymentSuccess(); },
        onFailure: function() { onPaymentFailure(); },
        onClose:   function() {},
      });
      checkout.open();
    } else {
      containerEl.innerHTML =
        '<iframe src="' + checkoutUrl + '" ' +
        'style="width:100%;height:500px;border:none;border-radius:8px" ' +
        'allow="payment" title="Pago seguro"></iframe>';
    }
  } catch (err) {
    console.error('[checkout]', err);
    loadingEl.style.display = 'none';
    errorEl.hidden = false;
    orderId = null;
  }
}

function onPaymentSuccess() {
  navigate('/ticket.html?estado=procesando&oid=' + encodeURIComponent(orderId || ''));
}

function onPaymentFailure() {
  checkoutMounted = false;
  document.getElementById('checkout-error').hidden  = false;
  document.getElementById('checkout-loading').style.display = 'none';
  document.getElementById('recurrente-checkout-container').innerHTML = '';
  orderId = null;
}

// ── Boot ──────────────────────────────────────────────────────────────────
init();
window.addEventListener('resize', function() {
  updateMobileCta(checkoutOpen ? currentStep : 0);
});
</script>
